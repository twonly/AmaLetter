# DeepSeek API key — required for the AI generation route
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional: override the base URL (defaults to the official endpoint)
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# Supabase — optional, but required for shareable letter links
# Without these, letters still work in the writer's own session,
# but shared links will show "this letter has no record".
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.xxxxxxxx

# Site URL (used by OG metadata, optional)
# NEXT_PUBLIC_SITE_URL=https://amaletter.com
